# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
myenv/
.pytest_cache/

# Node / Expo (ui/)
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo

# Secrets — never commit a real one. Templates (*.example) are fine.
.env
.env.*
!.env*example
!.env*sample
!.env*template
# The quickstart template: development-only values, deliberately committed so
# `cp config/.env.local .env` works on a fresh clone. Not a real secret.
!config/.env.local
*.pem
*.key
*.p12
*.pfx

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log

# AWS deployment. These publish to OUR EC2 estate via SSM and name the
# instances. Deployment to our infrastructure is not something a self-hoster
# runs, and this repository is public. Mirrors citra-decision-system.
**/deploy.sh
**/deploy.yml
**/DEPLOY-CHECKLIST.md
**/docker-compose.aws.yml

# Setup wizard checkpoint log (and its --fresh archives)
.wizard-state.log*
