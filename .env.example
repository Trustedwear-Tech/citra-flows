# ─────────────────────────────────────────────────────────────────────────
# Citra Flows — the one configuration file.
#
#   cp .env.example .env
#
# There is ONE .env, at the repository root. Both services are fed it by
# docker-compose.quickstart.yml (`env_file: [.env]`), whose `environment:`
# blocks then override the host-oriented values below with compose service
# names — so the same file works for `uvicorn` on the host and for the
# containerised stack. Services do NOT read per-directory .env files.
#
# Safe to use as-is on a laptop. The secrets below are DEVELOPMENT values and
# are deliberately committed so a fresh clone runs with no setup. Change every
# one of them before this is reachable by anyone but you.
#
# Only LLM_API_KEY needs your attention, and only for AI features (the AI
# workflow author, and the LLM/agent/classifier nodes). Everything else —
# sign-in, the builder, sources, transforms, outputs, scheduling — runs
# without it.
# ─────────────────────────────────────────────────────────────────────────

ENVIRONMENT=dev
LOG_LEVEL=INFO

# ── Sign-in ───────────────────────────────────────────────────────────────
# HS256 secret the API signs user tokens with and the auth middleware verifies.
# There is no default in code: the service refuses to mint tokens without it
# rather than fall back to a guessable value.
#   Generate: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-8f4c1d6b2a9e7503bd1e4a8c6f2093d7
JWT_ISSUER=Citra-Flows

# The FIRST account, created once at startup when the user collection is empty.
# There is no public sign-up — this is an engine you run for your own team.
#
# The address must be a real, routable-looking email. Reserved domains such as
# `.local`, `.test` and `.invalid` are rejected at sign-in, and an account
# created with one can never log in.
WORKFLOW_BOOTSTRAP_EMAIL=admin@example.com
WORKFLOW_BOOTSTRAP_PASSWORD=change-me-locally
# Required: an identity with no org is rejected by every workflow endpoint, so
# an account created without one can sign in and then get 403 from everything.
WORKFLOW_BOOTSTRAP_ORG_ID=local

# ── Ports (host side) ─────────────────────────────────────────────────────
# Change these if something else already owns them. FLOWS_API_PORT is baked
# into the UI bundle, so after changing it run `make build`, not just restart.
FLOWS_API_PORT=9200
FLOWS_UI_PORT=8088

# ── Data stores ───────────────────────────────────────────────────────────
# Used by docker-compose.infra.yml to create the accounts, and by the app
# services to connect. Hostnames are injected by the compose file.
MONGODB_USER=flows
MONGODB_PASSWORD=flows-local-dev
MONGODB_DATABASE=citra_flows

# ── File outputs (Excel/CSV/PDF exports, sandbox artifacts) ───────────────
# Points at the bundled MinIO. For real S3, set BUCKET_NAME/AWS_* and remove
# BUCKET_ENDPOINT_URL from docker-compose.quickstart.yml.
BUCKET_NAME=citra-flows-local
BUCKET_REGION=us-east-1
MINIO_ROOT_USER=flowsadmin
MINIO_ROOT_PASSWORD=flows-local-dev

# ── Models (optional) ─────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint: OpenRouter, together.ai, or your own vLLM /
# Ollama / LM Studio. Nothing leaves your network if you point it inward.
#
#   Ollama:  LLM_BASE_URL=http://host.docker.internal:11434/v1
#            LLM_API_KEY=ollama
#            LLM_MODEL=llama3.1
#
# Leave LLM_API_KEY empty to run without AI features; nodes that need a model
# fail loudly with a clear message rather than silently doing nothing.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# The small tier is used for cheap classification-style calls. It falls back
# to the main tier when unset.
LLM_SMALL_BASE_URL=
LLM_SMALL_API_KEY=
LLM_SMALL_MODEL=
